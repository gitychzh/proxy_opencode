@echo off
REM balancer 配置模板；复制为 run.cmd 后按机器实际情况修改。
REM 不要提交含真实 key 的 run.cmd（已被 .gitignore 排除）。
REM 双击 run.cmd 启动；当前部署形态见 docs/OPERATIONS.md。
chcp 65001 >nul
set "ROOT=%~dp0.."
cd /d "%ROOT%"
if not exist "%ROOT%\logs" mkdir "%ROOT%\logs"

REM ── 监听 ──────────────────────────────────────────────────────────────
REM 0.0.0.0 让 tailnet 上其他设备也能用；仅本机调试改成 127.0.0.1
set "ZEN_LB_HOST=0.0.0.0"
set "ZEN_LB_PORT=7892"

REM ── 客户端 key ────────────────────────────────────────────────────────
REM 调用方（hermes 等）用它访问 LB。LB 会为每个上游改写成各自的 key，
REM 客户端的 key 不会泄漏到任何后端（见 tests/test_balancer.py）。
REM 未设置时 LB 拒绝一切请求（fail-closed），不会裸奔。
set "ZEN_LB_API_KEY=CHANGE-ME-lb-client-key"

REM ── 上游桶（分号分隔，格式 名称|URL|该桶的 key）────────────────────────
REM 配额按出口 IP 计，所以每个桶必须位于不同出口 IP 的机器上。同出口 IP 的
REM 两个网关只是同一份额度，不构成两个桶。
REM least-connection 轮询：谁空闲去谁；不可用的桶自动跳过。
REM 未设置 ZEN_LB_UPSTREAMS 时 LB 以 503 fail-closed（代码里不内置任何真实 key）。
set "ZEN_LB_UPSTREAMS=bucket-a|http://127.0.0.1:8791|CHANGE-ME-gateway-key;bucket-b|http://OTHER-BUCKET-IP:8791|CHANGE-ME-other-gateway-key"

REM ── 日志 ──────────────────────────────────────────────────────────────
REM 不设则默认写到脚本同级的 logs/lb.log（相对路径，不绑定任何盘符）
set "ZEN_LB_LOG=%ROOT%\logs\lb.log"
set "PYTHONUNBUFFERED=1"

REM 用项目虚拟环境运行，不污染系统 Python
"%ROOT%\.venv\Scripts\python.exe" "%ROOT%\balancer\lb.py" >> "%ROOT%\logs\stdout.log" 2>&1
