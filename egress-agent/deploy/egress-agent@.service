[Unit]
Description=egress-agent (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The unit runs a dedicated venv under /opt so it works with ProtectHome=true
# (a venv in a user's $HOME would be hidden from the service). A host that
# installs elsewhere overrides ExecStart with a systemd drop-in.
Environment=EGRESS_AGENT_CONFIG=/etc/egress-agent/%i.json
ExecStart=/opt/egress-agent/venv/bin/python -m egress_agent run --config ${EGRESS_AGENT_CONFIG}
Restart=on-failure
RestartSec=5

# Hardening: the agent needs no capabilities, no home, no /tmp.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/egress-agent
StateDirectory=egress-agent
LogsDirectory=egress-agent

[Install]
WantedBy=multi-user.target
